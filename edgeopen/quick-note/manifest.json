{
  "manifest_version": 3,
  "name": "随心记",
  "version": "1.0.0",
  "description": "便签式快速记录，支持粘贴/拖拽/选择图片，本地离线存储。",
  "action": {
    "default_title": "随心记",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "commands",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "open-quick-note": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开随心记"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["preview.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
